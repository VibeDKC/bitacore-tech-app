# URL pública del catálogo en Supabase Storage.
# Si se omite, la web usa el snapshot local de web/data/catalog.json.
CATALOG_URL=https://lvcwyceaxxwsdobghrlj.supabase.co/storage/v1/object/public/catalogo-web/catalog.json

# Opcional: si falta, se deriva orders-demo.json desde CATALOG_URL.
ORDERS_URL=

# Revalidación ISR en segundos (mínimo 30).
CATALOG_REVALIDATE_SECONDS=60

# URL canónica para metadatos. En Vercel se puede omitir.
NEXT_PUBLIC_SITE_URL=https://bitacore-tech-app.vercel.app
